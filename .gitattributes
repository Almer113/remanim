# Text files are stored and checked out with LF everywhere (the studio's
# byte-exact edits and tests are written against LF files).
* text=auto eol=lf

# Windows batch files need CRLF to run reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.mp3 binary
*.wav binary
